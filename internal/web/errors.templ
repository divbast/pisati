package web

import "github.com/divbast/pisati/internal/web/msg"

// problemContent is an error page's content: what went wrong, as heading,
// a sentence more, as body, and a link home. Both come from the catalogue
// alone, never from the request.
templ problemContent(l msg.Lang, heading, body string) {
	<h1>{ heading }</h1>
	<p>{ body }</p>
	<p><a href="/">{ msg.BackHome(l) }</a></p>
}
